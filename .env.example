# Copia estas variables a tu entorno (o expórtalas antes de correr la app).
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=reservas_salas
# Restringe el registro a un dominio (vacío = cualquier correo)
DOMINIO=
# 1 = crea usuarios de demostración si la base está vacía (solo para desarrollo)
SEED_DEMO=0
# 1 = modo depuración (solo desarrollo)
FLASK_DEBUG=0
# 1 = cookies solo por HTTPS (actívalo en producción)
COOKIE_SECURE=0
# 1 = solo si hay un proxy de confianza delante (Render, Nginx...): usa la IP real del visitante
TRUST_PROXY=0
# Máximo de peticiones por minuto por IP (en un campus con una sola IP pública, súbelo)
RATE_LIMIT_PER_MIN=600

